{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "github": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GitHub Models",
      "options": {
        "baseURL": "https://models.github.ai/inference",
        "apiKey": "{env:GITHUB_TOKEN}"
      },
      "models": {
        "gpt-4o-mini": {
          "name": "GPT-4o mini"
        }
      }
    }
  }
}